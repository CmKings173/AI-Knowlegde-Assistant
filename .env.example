APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATA_DIR=data
UPLOAD_DIR=data/uploads
DOCUMENTS_DIR=data/documents
PROCESSED_DIR=data/processed
MAX_UPLOAD_MB=50
MAX_QUESTION_CHARS=2000
# Set in production so continuation tokens survive restarts/workers.
# CONTINUATION_SECRET=

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=company_knowledge

EMBEDDING_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=16

# Future self-hosted embedding options.
# Ollama embedding is enabled in code through EMBEDDING_PROVIDER=ollama.
#
# Option A: Hugging Face Text Embeddings Inference / TEI
# EMBEDDING_PROVIDER=tei
# TEI_EMBEDDING_URL=http://localhost:8081
# TEI_EMBEDDING_MODEL=BAAI/bge-m3
#
# Option B: Infinity
# EMBEDDING_PROVIDER=infinity
# INFINITY_BASE_URL=http://localhost:7997
# INFINITY_EMBEDDING_MODEL=BAAI/bge-m3

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:14b
OLLAMA_MODEL=qwen2.5:14b-instruct
LLM_TIMEOUT_SECONDS=240
OPENAI_MODEL=
GEMINI_MODEL=gemini-2.5-flash

RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Future self-hosted reranker options.
# Current code keeps reranking disabled; retrieval uses Qdrant + BM25 + RRF top-k.
# Enable this after adding a real reranker provider implementation.
#
# Option A: Hugging Face Text Embeddings Inference / TEI
# RERANKER_ENABLED=true
# RERANKER_PROVIDER=tei
# TEI_RERANKER_URL=http://localhost:8082
# TEI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
#
# Option B: Infinity
# RERANKER_ENABLED=true
# RERANKER_PROVIDER=infinity
# INFINITY_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

DENSE_TOP_K=15
LEXICAL_TOP_K=15
FUSION_TOP_K=20
RERANK_TOP_K=20
FINAL_CONTEXT_TOP_N=4
MIN_RETRIEVAL_SCORE=0.01
MAX_CONTEXT_TOKENS=3000
# Calibrate these evidence gates with scripts/evaluate_retrieval.py on production data.
EVIDENCE_MIN_DENSE_SCORE=0.45
EVIDENCE_MIN_BM25_SCORE=1.0
EVIDENCE_COHERENT_DOMAIN_MIN_CHUNKS=2

CHUNK_TARGET_TOKENS=350
CHUNK_MAX_TOKENS=550
CHUNK_OVERLAP_TOKENS=40
PARENT_MAX_TOKENS=1200

DEBUG_ENDPOINTS_ENABLED=true
